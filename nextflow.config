nextflow.enable.dsl = 2

params.run_id = null
params.outdir = null
params.experiment = 'independent_jobs'
params.items = 8
params.batch_size = 1
params.sleep_seconds = 1
params.cpu_seconds = 0
params.mem_mb = 0
params.io_mb = 1
params.workload = 'basic'
params.zp_z = 20
params.zp_y = 32
params.zp_x = 32
params.zp_objects = 4
params.fail_items = ''
params.max_items = 256
params.max_batch_size = 64
params.max_sleep_seconds = 300
params.max_cpu_seconds = 300
params.max_mem_mb = 4096
params.max_io_mb = 256
params.max_zp_voxels = 1048576
params.max_zp_objects = 128

profiles {
  local_smoke {
    process.executor = 'local'
    executor.queueSize = 2
    params.items = 4
    params.batch_size = 1
    params.sleep_seconds = 1
    params.io_mb = 1
  }

  alpine {
    includeConfig 'conf/alpine.reference.config'
  }
}

trace {
  enabled = true
  file = "${params.outdir ?: 'results/' + (params.run_id ?: 'manual')}/trace.tsv"
  overwrite = true
}

timeline {
  enabled = true
  file = "${params.outdir ?: 'results/' + (params.run_id ?: 'manual')}/timeline.html"
  overwrite = true
}

report {
  enabled = true
  file = "${params.outdir ?: 'results/' + (params.run_id ?: 'manual')}/report.html"
  overwrite = true
}

dag {
  enabled = true
  file = "${params.outdir ?: 'results/' + (params.run_id ?: 'manual')}/dag.html"
  overwrite = true
}
