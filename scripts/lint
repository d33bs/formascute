#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

have() {
  command -v "$1" >/dev/null 2>&1
}

echo "shell syntax"
while IFS= read -r path; do
  bash -n "$path"
  echo "ok: ${path#"$ROOT_DIR"/}"
done < <(find "$ROOT_DIR" -path "$ROOT_DIR/.git" -prune -o -type f -name '*.sh' -print; printf '%s\n' "$ROOT_DIR/bin/formascute" "$ROOT_DIR/scripts/check" "$ROOT_DIR/scripts/lint")

echo
echo "shellcheck"
if have shellcheck; then
  shellcheck "$ROOT_DIR/bin/formascute" "$ROOT_DIR/scripts/check" "$ROOT_DIR/scripts/lint"
  while IFS= read -r path; do
    shellcheck "$path"
  done < <(find "$ROOT_DIR" -path "$ROOT_DIR/.git" -prune -o -type f -name '*.sh' -print)
else
  echo "skip: shellcheck is not installed"
fi

echo
echo "markdownlint"
if have markdownlint-cli2; then
  markdownlint-cli2
elif have markdownlint; then
  markdownlint README.md PLAN.md docs/**/*.md
elif have npx; then
  npx --yes markdownlint-cli2
else
  echo "skip: markdownlint is not installed"
fi

echo
echo "nextflow"
if have nextflow && nextflow -version >/dev/null 2>&1; then
  nextflow config "$ROOT_DIR/workflows/synthetic.nf" \
    -profile local_smoke \
    -c "$ROOT_DIR/nextflow.config" \
    -c "$ROOT_DIR/conf/characterization.config" \
    -c "$ROOT_DIR/conf/experiments/independent_jobs.config" \
    >/dev/null
  echo "ok: nextflow config local_smoke"
else
  echo "skip: nextflow is not installed or not runnable"
fi
