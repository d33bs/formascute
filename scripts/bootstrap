#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_DIR="${FORMASCUTE_ENV_DIR:-$ROOT_DIR/.formascute/conda}"

have() {
  command -v "$1" >/dev/null 2>&1
}

if [[ -x "$ENV_DIR/bin/nextflow" && -x "$ENV_DIR/bin/java" ]]; then
  echo "ok: existing formascute environment at $ENV_DIR"
  "$ENV_DIR/bin/nextflow" -version | sed -n '1,6p'
  exit 0
fi

if have conda; then
  conda create -y -p "$ENV_DIR" -c conda-forge -c bioconda nextflow openjdk=17
elif have mamba; then
  mamba create -y -p "$ENV_DIR" -c conda-forge -c bioconda nextflow openjdk=17
else
  echo "conda or mamba is required for bootstrap" >&2
  exit 127
fi

"$ENV_DIR/bin/nextflow" -version | sed -n '1,6p'
