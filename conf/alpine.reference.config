/*
 * Reference Slurm and Singularity settings for the CURC Alpine baseline.
 * Treat this as the control configuration. Experiments should override one
 * setting at a time in a separate config file.
 */

def formascute_user = System.getenv('USER') ?: 'unknown'
def formascute_scratch = System.getenv('FORMASCUTE_SCRATCH') ?: "/scratch/alpine/${formascute_user}"
def formascute_project = System.getenv('FORMASCUTE_PROJECT') ?: "/projects/${formascute_user}"
def formascute_container_enabled = (System.getenv('FORMASCUTE_ENABLE_CONTAINER') ?: 'false').toBoolean()

params {
  config_profile_description = 'CURC Alpine cluster profile'
  config_profile_contact = 'Thomas Danhorn'
  slurm_account = System.getenv('FORMASCUTE_ACCOUNT') ?: ''
  slurm_partition = System.getenv('FORMASCUTE_PARTITION') ?: 'acpu'
  slurm_qos = System.getenv('FORMASCUTE_QOS') ?: 'cpu-normal'
  scratch_root = formascute_scratch
  project_root = formascute_project
  max_memory = 240.GB
  max_cpus = 48
  max_time = 24.h
}

singularity {
  enabled = formascute_container_enabled
  cacheDir = "${params.project_root}/container_cache"
  autoMounts = true
  runOptions = "-B ${params.scratch_root}:/tmp"
}

process {
  executor = 'slurm'
  queue = params.slurm_partition
  errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
  maxRetries = 3
  time = 30.m
  clusterOptions = {
    def opts = []
    if (params.slurm_account) {
      opts << "--account=${params.slurm_account}"
    }
    if (params.slurm_qos) {
      opts << "--qos=${params.slurm_qos}"
    }
    opts.join(' ')
  }

  withLabel:process_long {
    clusterOptions = {
      def opts = []
      if (params.slurm_account) {
        opts << "--account=${params.slurm_account}"
      }
      if (params.slurm_qos) {
        opts << "--qos=${params.slurm_qos}"
      }
      opts.join(' ')
    }
    time = 24.h
  }
}

executor {
  name = 'slurm'
  queueSize = 200
  perJobMemLimit = true
  submitRateLimit = '30 / 1 min'
  killBatchSize = 50
}

env {
  SINGULARITY_TMPDIR = "${params.scratch_root}/singularity/tmp"
  SINGULARITY_CACHEDIR = "${params.scratch_root}/singularity/cache"
}
