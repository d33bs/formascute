/*
 * Confirms CURC's exact production suggestion at small scale:
 *   queueSize = 200 (conservative production default, aligned with the
 *   campus/user active-job limit)
 *   submitRateLimit = '200 / 60 min' (CURC's suggested throttle shape)
 *
 * At this tiny item count the rate limit should not engage (well under
 * 200 submissions), so this experiment checks that the production config
 * shape is accepted and does not change tiny-run behavior versus the
 * unthrottled nf1_featurization_independent baseline.
 */
executor {
  queueSize = 200
  submitRateLimit = '200 / 60 min'
}

params {
  experiment = 'nf1_submit_rate_prod_ratio'
  items = 16
  batch_size = 1
  sleep_seconds = 3
  io_mb = 2
}
