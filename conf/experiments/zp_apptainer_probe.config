/*
 * Mirrors zp_synthetic_features but routes the task through the
 * project-owned Apptainer image built with the same dependency set as the
 * validated `uv` environment (zedprofiler, mahotas, pyarrow, numpy, pandas,
 * scikit-image on Python 3.12), for a direct comparison against the uv path.
 * Requires FORMASCUTE_ENABLE_CONTAINER=true when invoking Nextflow.
 */
process {
  container = "/projects/${System.getenv('USER')}/software/apptainer/zedprofiler.sif"
}

params {
  experiment = 'zp_apptainer_probe'
  workload = 'zedprofiler_sim'
  items = 4
  batch_size = 1
  sleep_seconds = 0
  cpu_seconds = 1
  io_mb = 0
  zp_z = 20
  zp_y = 32
  zp_x = 32
  zp_objects = 4
}
